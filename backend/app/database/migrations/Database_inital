-- Update for adding a new table : Enrollment, also fix a concern of cross certificate in combine weekly_study_hours
-- add_enrollments.sql
-- Additive migration for DB_AICert_Platform_V5.
-- Creates the enrollments table only. No existing table, column or constraint is changed.
-- Requires: users and certifications already exist.

BEGIN;

CREATE TABLE IF NOT EXISTS enrollments (
	id BIGINT NOT NULL GENERATED BY DEFAULT AS IDENTITY,
	user_id BIGINT NOT NULL,
	certification_id BIGINT NOT NULL,
	goal TEXT,
	deadline DATE,
	weekly_study_hours NUMERIC(5,2),
	status VARCHAR(32) NOT NULL DEFAULT 'active',
	created_at TIMESTAMP NOT NULL DEFAULT now(),
	PRIMARY KEY (id),
	FOREIGN KEY (user_id) REFERENCES users(id)
		ON UPDATE NO ACTION ON DELETE NO ACTION,
	FOREIGN KEY (certification_id) REFERENCES certifications(id)
		ON UPDATE NO ACTION ON DELETE NO ACTION,
	CONSTRAINT enrollments_status_check
		CHECK (status IN ('active', 'paused', 'completed', 'abandoned')),
	-- one week has 168 hours; a single course cannot exceed that
	CONSTRAINT enrollments_weekly_hours_check
		CHECK (weekly_study_hours IS NULL OR (weekly_study_hours > 0 AND weekly_study_hours <= 168))
);

-- Fix 1 + 2: a learner can have only ONE open enrollment per certification.
-- Completed or abandoned rows are not counted, so the learner can enroll again
-- (for example to retake an exam) and the old row is kept as history.
-- The columns are (user_id, certification_id). There is no skill_id.
CREATE UNIQUE INDEX IF NOT EXISTS enrollments_one_open_per_cert
	ON enrollments (user_id, certification_id)
	WHERE status IN ('active', 'paused');

-- Lookups by learner and by certification (FK columns are not indexed automatically).
CREATE INDEX IF NOT EXISTS enrollments_user_id_idx ON enrollments (user_id);
CREATE INDEX IF NOT EXISTS enrollments_certification_id_idx ON enrollments (certification_id);

-- Fix 3: weekly_study_hours across all open enrollments of one learner.
-- A database cannot know how many hours a learner really has, so this only enforces
-- the physical limit of 168 hours per week. Lower max_weekly_hours if the product
-- sets a stricter rule.
CREATE OR REPLACE FUNCTION enrollments_check_total_hours() RETURNS trigger AS $$
DECLARE
	max_weekly_hours CONSTANT NUMERIC := 168;
	other_hours NUMERIC;
BEGIN
	IF NEW.status NOT IN ('active', 'paused') OR NEW.weekly_study_hours IS NULL THEN
		RETURN NEW;
	END IF;

	-- serialize concurrent writes for the same learner
	PERFORM pg_advisory_xact_lock(NEW.user_id);

	SELECT COALESCE(SUM(weekly_study_hours), 0) INTO other_hours
	FROM enrollments
	WHERE user_id = NEW.user_id
	  AND status IN ('active', 'paused')
	  AND id IS DISTINCT FROM NEW.id;

	IF other_hours + NEW.weekly_study_hours > max_weekly_hours THEN
		RAISE EXCEPTION 'Total weekly_study_hours of open enrollments (%) would exceed % for user %',
			other_hours + NEW.weekly_study_hours, max_weekly_hours, NEW.user_id
			USING ERRCODE = 'check_violation';
	END IF;

	RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS enrollments_check_total_hours_trg ON enrollments;
CREATE TRIGGER enrollments_check_total_hours_trg
	BEFORE INSERT OR UPDATE OF weekly_study_hours, status, user_id ON enrollments
	FOR EACH ROW EXECUTE FUNCTION enrollments_check_total_hours();

COMMENT ON TABLE enrollments IS 'One learner studying one certification. Holds the per-course goal, deadline and weekly hours.';
COMMENT ON COLUMN enrollments.status IS 'active, paused, completed or abandoned';

COMMIT;
