# Copy this file to backend/.env and fill in real values.
# backend/.env is local. Do not commit it.

APP_ENV=local

# Supabase session pooler. For the Homebrew database on this Mac, use:
# postgresql://kethanumanarayanan@localhost:5432/platform
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Print SQL in the terminal. Leave false except while debugging.
DB_ECHO=false

# Connections kept open. Raise these when more learners are using the API at once.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
# Keep at 0 for the Supabase pooler. A direct Postgres server can use 100.
DB_STATEMENT_CACHE_SIZE=0

# AI team: fill the block you actually use. Leave the rest blank.
# Tutor replies: ai/language_model/azure_openai.py
#                ai/agents/tutor/graph.py, nodes.py, tools.py
OPENAI_API_KEY=
TUTOR_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Retrieval: ai/knowledge_retrieval/retriever.py
#            vector_store/pgvector_store.py uses DATABASE_URL above
#            vector_store/azure_search_store.py uses the three lines below
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# Comma-separated frontend origins. Add the deployed site when you have one.
CORS_ORIGINS=http://localhost:3000
