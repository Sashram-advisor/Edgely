# Merged Edgely + AI Tutor environment.
# Copy to backend/.env and fill in real values. backend/.env is gitignored.
#
# The same file is read by:
#   - Edgely:  app/core/config.py (DATABASE_URL, SUPABASE_URL, CORS_ORIGINS, ...)
#   - AI Tutor: services/ai_tutor/backend/app/config.py (SUPABASE_*, ANTHROPIC_*, ...)
#   - Local bridge: app/integrations/local_tutor_api.py (OLLAMA_*)

APP_ENV=local
APP_NAME=Sashram Agentic AI Certification Platform

# --- Edgely database -------------------------------------------------------------------------
# Supabase session pooler / direct Postgres connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_CACHE_SIZE=0

# --- Supabase --------------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Server-only key used by the AI Tutor backend (service role / secret key).
# Never expose this in a browser or commit it.
SUPABASE_SECRET_KEY=
# Only needed if your project still signs JWTs with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# --- AI Tutor: chat model --------------------------------------------------------------------
# Claude is used for answer generation and follow-up rewriting.
ANTHROPIC_API_KEY=
# Alias accepted by the upstream AI Tutor config:
# CLAUDE_API_KEY=
CHAT_MODEL=claude-haiku-4-5
REWRITE_MODEL=claude-haiku-4-5
MAX_ANSWER_TOKENS=1024
HISTORY_MESSAGES=10

# --- AI Tutor: embeddings + retrieval --------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
GEMINI_API_KEY=
OPENAI_API_KEY=
RETRIEVAL_K=6
MIN_SIMILARITY=0.55

# --- Edgely AI placeholders (unchanged upstream settings) ------------------------------------
TUTOR_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# --- Local Ollama tutor (the Ai Tutor.zip implementation) ------------------------------------
# Terminal version: cd services/local_tutor && python main.py
# HTTP version:     POST http://localhost:8000/local-tutor/chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
LOCAL_TUTOR_MAX_SECTIONS=2
# Optional absolute path to a different study material file.
# LOCAL_TUTOR_MATERIAL=C:\path\to\study_material.txt

# --- CORS ------------------------------------------------------------------------------------
# Comma-separated list; the Streamlit dev UI does not need CORS, but a future
# Next.js frontend on :3000 does.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
