# =============================================================================================
# Edgely environment — SINGLE source of truth.
# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.
#
# There is intentionally ONE template. The old backend/app/core/.env.example is stale
# and has been removed; if you still have it, ignore it — this file is canonical.
#
# Read by:
#   - Edgely:          app/core/config.py            (DATABASE_URL, SUPABASE_URL, CORS_ORIGINS, ...)
#   - AI Tutor:        services/ai_tutor/backend/app/config.py (SUPABASE_*, ANTHROPIC_*, ...)
#   - Local bridge:    app/integrations/local_tutor_api.py      (OLLAMA_*)
#   - Frontend (.env.local, NOT this file): NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# =============================================================================================

# local | development | production. Both the code default AND this template are
# "production" (T5): copying this file to a server can never expose the
# unauthenticated /ai-tutor or /local-tutor apps by accident. With production,
# /tutor (login required) is the only tutor surface, and app.merged_main refuses
# to start if any other tutor route is registered.
#
# On YOUR laptop only, change this to APP_ENV=local if you need the Streamlit dev
# UI (/ai-tutor) or the offline Ollama tutor (/local-tutor); each still needs its
# own ENABLE_* flag below.
APP_ENV=production
APP_NAME=Sashram Agentic AI Certification Platform

# The original AI tutor app has NO authentication: it trusts a user_id supplied
# by the caller. It is mounted at /ai-tutor only when APP_ENV=local AND this
# flag is true. Leave it false unless you are running the Streamlit dev UI.
# NEVER enable this on a deployed server.
ENABLE_LEGACY_TUTOR_MOUNT=false

# The offline Ollama bridge (/local-tutor) is also unauthenticated. Mount it
# only for local, offline experimentation. Same two-switch rule as above.
ENABLE_LOCAL_TUTOR_MOUNT=false

# --- Edgely database -------------------------------------------------------------------------
# Supabase session pooler / direct Postgres connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_CACHE_SIZE=0

# --- Supabase --------------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Server-only key used by the AI Tutor backend (service role / secret key).
# Never expose this in a browser or commit it.
SUPABASE_SECRET_KEY=
# Only needed if your project still signs JWTs with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# --- AI Tutor: chat model --------------------------------------------------------------------
# Claude is used for answer generation and follow-up rewriting.
ANTHROPIC_API_KEY=
# Alias accepted by the upstream AI Tutor config:
# CLAUDE_API_KEY=
CHAT_MODEL=claude-haiku-4-5
REWRITE_MODEL=claude-haiku-4-5
MAX_ANSWER_TOKENS=1024
HISTORY_MESSAGES=10
# T4: when to spend a second model call rewriting a follow-up question for retrieval.
#   auto   = only when the message looks like a follow-up ("what about Glacier?") — default
#   always = every message after the first (pre-P1 behaviour, 2 model calls per question)
#   off    = never
REWRITE_MODE=auto

# --- AI Tutor: per-learner rate limit (T4) ----------------------------------------------------
# Questions a learner may ask per rolling minute / rolling 24 hours, across
# /tutor/chat and /tutor/chat/stream. Over the limit -> HTTP 429 + Retry-After.
# 0 switches that window off. Counters are in-process: with N workers the real
# limit is N x these values.
TUTOR_RATE_LIMIT_PER_MINUTE=10
TUTOR_RATE_LIMIT_PER_DAY=200

# --- AI Tutor: embeddings + retrieval --------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
GEMINI_API_KEY=
OPENAI_API_KEY=
RETRIEVAL_K=6
MIN_SIMILARITY=0.55

# --- Edgely AI placeholders (unchanged upstream settings) ------------------------------------
TUTOR_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# --- Local Ollama tutor (the Ai Tutor.zip implementation) ------------------------------------
# Terminal version: cd services/local_tutor && python main.py
# HTTP version:     POST http://localhost:8000/local-tutor/chat  (requires ENABLE_LOCAL_TUTOR_MOUNT=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
LOCAL_TUTOR_MAX_SECTIONS=2
# Optional absolute path to a different study material file.
# LOCAL_TUTOR_MATERIAL=C:\path\to\study_material.txt

# --- CORS ------------------------------------------------------------------------------------
# Comma-separated list; the Streamlit dev UI does not need CORS, but a future
# Next.js frontend on :3000 does. Add any deployed frontend origin here too.
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
