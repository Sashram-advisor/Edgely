# Copy this file to frontend/.env.local and fill in real values.
# frontend/.env.local is gitignored. NEVER commit the anon key anywhere else.

# Supabase project settings — shown in the Supabase dashboard under
# Project Settings > API. The anon key is safe to ship to the browser; the
# service role / secret key must stay on the backend only.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Edgely FastAPI backend (the merged app: uvicorn app.merged_main:app).
# The frontend attaches the Supabase access token as `Authorization: Bearer <token>`.
NEXT_PUBLIC_API_URL=http://localhost:8000
